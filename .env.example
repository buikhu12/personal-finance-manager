# ===================================================================
# Personal Finance Manager - Environment Configuration Template
# Sao chép file này thành .env và điền thông tin phù hợp
# ===================================================================

PORT=8080

# Database Configuration (H2 File - Mặc định)
DB_DRIVER=org.h2.Driver
DB_URL=jdbc:h2:file:./data/finance_db;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=sa
DB_PASSWORD=
JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect
H2_CONSOLE_ENABLED=true

# Database Configuration (MySQL - Mẫu)
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_URL=jdbc:mysql://localhost:3306/finance_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=your_password
# JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect
# H2_CONSOLE_ENABLED=false

# JPA / Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Logging
LOG_SECURITY=WARN
LOG_SQL=WARN
